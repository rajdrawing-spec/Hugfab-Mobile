# Copy to .env.local and fill in. `.env` and `.env*.local` are git-ignored.
#
# EXPO_PUBLIC_* is the only prefix Expo exposes to the running app — and it is
# inlined into the JS bundle, which anyone can unzip out of an APK. Nothing that
# is not already public may go in this file.

# Where the HugFab API lives.
#
# Production: https://hugfab.com
# Against a local `next dev`: your machine's LAN address, e.g. http://192.168.1.8:3000
#
# NEVER http://localhost:3000 — on a phone, localhost is the phone. It will
# always fail, and the failure looks like the API being down.
EXPO_PUBLIC_API_BASE_URL=https://hugfab.com

# Supabase, for authentication only. The same project the web app uses.
# The ANON key and nothing else: SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely
# and must never reach a client.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
